# Plantilla de configuración para poner Sentinel en línea.
# Copia este archivo como `.env` y rellena los valores reales.

# --- Obligatorio ---------------------------------------------------------
# Clave que firma las sesiones. SIN ella la app no arranca en producción.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Base de datos -------------------------------------------------------
# En línea usa PostgreSQL. Muchos servicios la entregan ya como DATABASE_URL.
# Si se deja vacío, se usa SQLite local (solo recomendado en desarrollo o
# en un único servidor con disco persistente).
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/sentinel

# Contraseña para el PostgreSQL de docker-compose.yml
# POSTGRES_PASSWORD=cambia-esta-clave

# --- Entorno -------------------------------------------------------------
# "produccion" activa cookies seguras (solo HTTPS), proxy y Gunicorn.
ENTORNO=produccion
PORT=8080

# Sirve con Gunicorn (solo Linux/macOS). 2 es un buen punto de partida.
# WEB_CONCURRENCY=2

# --- Datos iniciales -----------------------------------------------------
# Pon 1 la primera vez para crear los usuarios de demostración
# (admin / admin123). Después, cámbialo a 0.
DATOS_DEMO=0
